<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="Ribbon_Load">
  <ribbon>
    <tabs>
      <tab id="AITab" label="AI Agent">
        <group id="AgentGroup" label="Agent">
          <button id="ChatBtn" label="Chat"
                  imageMso="Conversation"
                  size="large"
                  onAction="OnChatClick"
                  screentip="Buka AI Agent Chat"
                  supertip="Buka panel chat untuk berinteraksi dengan AI Agent"/>
          <button id="RunLastBtn" label="Run Last"
                  imageMso="ReviewAcceptChange"
                  size="medium"
                  onAction="OnRunLastClick"
                  screentip="Jalankan Perintah Terakhir"
                  supertip="Jalankan ulang perintah terakhir yang dikirim ke AI Agent"/>
          <button id="ClearLogBtn" label="Clear Log"
                  imageMso="Delete"
                  size="small"
                  onAction="OnClearLogClick"
                  screentip="Hapus Log Chat"
                  supertip="Hapus semua riwayat chat dari AI Agent"/>
        </group>
        <group id="SettingsGroup" label="Settings">
          <button id="SettingsBtn" label="Settings"
                  imageMso="Options"
                  size="medium"
                  onAction="OnSettingsClick"
                  screentip="Pengaturan AI Agent"
                  supertip="Konfigurasi endpoint API, API key, dan pengaturan lainnya"/>
          <button id="HelpBtn" label="Help"
                  imageMso="Help"
                  size="small"
                  onAction="OnHelpClick"
                  screentip="Bantuan AI Agent"
                  supertip="Tampilkan panduan penggunaan AI Agent"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>

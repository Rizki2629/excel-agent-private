{
  "version": "1.0.0",
  "description": "Excel Agent Skills - Based on MCP Server Excel best practices",
  "skills": [
    {
      "id": "range-format",
      "name": "Format Range",
      "description": "Apply number formats, cell styling, fonts, fills, borders, and alignment to ranges",
      "triggers": ["format", "style", "font", "color", "fill", "border", "alignment", "bold", "italic", "number format", "currency", "percent", "date format"],
      "officeApis": ["getRange", "format", "fill", "font", "numberFormat"],
      "workflow": [
        "1. Identify the range to format",
        "2. Determine format type (number, currency, percent, date, etc.)",
        "3. Apply format using .numberFormat or .format properties",
        "4. Verify with context.sync()"
      ],
      "formatCodes": {
        "currency": "$#,##0.00",
        "percent": "0.00%",
        "date-iso": "yyyy-mm-dd",
        "date-us": "mm/dd/yyyy",
        "number": "#,##0.00",
        "integer": "#,##0"
      },
      "examples": [
        {
          "request": "Format kolom C sebagai currency",
          "code": "sheet.getRange(\"C:C\").numberFormat = \"$#,##0.00\";\nawait context.sync();"
        },
        {
          "request": "Buat header bold dan warna biru",
          "code": "let header = sheet.getRange(\"1:1\");\nheader.format.font.bold = true;\nheader.format.fill.color = \"#4472C4\";\nheader.format.font.color = \"#FFFFFF\";\nawait context.sync();"
        }
      ]
    },
    {
      "id": "column-width",
      "name": "Set Column Width",
      "description": "Adjust column widths for optimal display",
      "triggers": ["column width", "lebar kolom", "width", "auto fit", " autofit"],
      "officeApis": ["getRange", "columnWidth", "autoFitColumns"],
      "workflow": [
        "1. Identify columns to adjust",
        "2. Set specific width or use autoFit",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Atur lebar kolom A jadi 7, B jadi 16, C jadi 18",
          "code": "sheet.getRange(\"A:A\").columnWidth = 7;\nsheet.getRange(\"B:B\").columnWidth = 16;\nsheet.getRange(\"C:C\").columnWidth = 18;\nawait context.sync();"
        },
        {
          "request": "Auto-fit semua kolom",
          "code": "sheet.getUsedRange().getColumns().autoFitColumns();\nawait context.sync();"
        }
      ]
    },
    {
      "id": "row-height",
      "name": "Set Row Height",
      "description": "Adjust row heights for optimal display",
      "triggers": ["row height", "tinggi baris", "height"],
      "officeApis": ["getRange", "rowHeight", "autoFitRows"],
      "workflow": [
        "1. Identify rows to adjust",
        "2. Set specific height or use autoFit",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Atur tinggi baris 1 jadi 30",
          "code": "sheet.getRange(\"1:1\").rowHeight = 30;\nawait context.sync();"
        }
      ]
    },
    {
      "id": "write-data",
      "name": "Write Data",
      "description": "Write values to cells or ranges",
      "triggers": ["write", "tulis", "set value", "input data", "isi"],
      "officeApis": ["getRange", "values"],
      "workflow": [
        "1. Identify target range",
        "2. Prepare 2D array of values",
        "3. Set .values property",
        "4. Verify with context.sync()"
      ],
      "criticalRules": [
        "Always use 2D array format: [[row1col1, row1col2], [row2col1, row2col2]]",
        "Strings must be in quotes: [[\"text\"]]",
        "Numbers are bare: [[42]]",
        "Write one row at a time for reliability"
      ],
      "examples": [
        {
          "request": "Tulis header di baris 1",
          "code": "sheet.getRange(\"A1:C1\").values = [[\"No\", \"Nama\", \"Nilai\"]];\nawait context.sync();"
        },
        {
          "request": "Tulis data di baris 2",
          "code": "sheet.getRange(\"A2:C2\").values = [[1, \"Budi\", 85]];\nawait context.sync();"
        }
      ]
    },
    {
      "id": "read-data",
      "name": "Read Data",
      "description": "Read values from cells or ranges",
      "triggers": ["read", "baca", "get value", "ambil data"],
      "officeApis": ["getRange", "values", "formulas"],
      "workflow": [
        "1. Identify source range",
        "2. Load values and/or formulas",
        "3. Use context.sync() to execute",
        "4. Process the loaded data"
      ],
      "examples": [
        {
          "request": "Baca data dari A1 sampai C10",
          "code": "let range = sheet.getRange(\"A1:C10\");\nrange.load(\"values\");\nawait context.sync();\nconsole.log(range.values);"
        }
      ]
    },
    {
      "id": "formula",
      "name": "Write Formulas",
      "description": "Insert Excel formulas into cells",
      "triggers": ["formula", "rumus", "sum", "average", "count", "function"],
      "officeApis": ["getRange", "formulas"],
      "workflow": [
        "1. Identify target cell/range",
        "2. Write formula using .formulas property",
        "3. Use A1 notation in formula string",
        "4. Verify with context.sync()"
      ],
      "criticalRules": [
        "Use .formulas (not .values) for formulas",
        "Formula must start with = sign",
        "Use A1 notation: =SUM(B2:B10)",
        "Reference other sheets: =SUM(Sheet2!B2:B10)"
      ],
      "examples": [
        {
          "request": "Tambahkan SUM di E1",
          "code": "sheet.getRange(\"E1\").formulas = [[\"=SUM(B1:D1)\"]];\nawait context.sync();"
        },
        {
          "request": "Hitung rata-rata di E2",
          "code": "sheet.getRange(\"E2\").formulas = [[\"=AVERAGE(B2:D2)\"]];\nawait context.sync();"
        }
      ]
    },
    {
      "id": "table",
      "name": "Create Table",
      "description": "Convert data range to Excel Table with structured references",
      "triggers": ["table", "tabel", "create table", "buat tabel"],
      "officeApis": ["getRange", "tables", "add"],
      "workflow": [
        "1. Ensure data has headers",
        "2. Select data range including headers",
        "3. Create table with name",
        "4. Verify with context.sync()"
      ],
      "benefits": [
        "Structured references",
        "Auto-expanding",
        "Required for Data Model/DAX",
        "Built-in filtering and sorting"
      ],
      "examples": [
        {
          "request": "Buat tabel dari data A1:D100",
          "code": "let range = sheet.getRange(\"A1:D100\");\nlet table = sheet.tables.add(range, true);\ntable.name = \"DataTable\";\nawait context.sync();"
        }
      ]
    },
    {
      "id": "sort",
      "name": "Sort Data",
      "description": "Sort data by one or more columns",
      "triggers": ["sort", "urutkan", "ascending", "descending"],
      "officeApis": ["getRange", "sort", "apply"],
      "workflow": [
        "1. Identify range to sort",
        "2. Specify sort key column(s)",
        "3. Apply sort with order (ascending/descending)",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Urutkan berdasarkan kolom B ascending",
          "code": "range.sort.apply([{ key: 2, ascending: true }]);\nawait context.sync();"
        },
        {
          "request": "Urutkan berdasarkan kolom A descending lalu B ascending",
          "code": "range.sort.apply([\n  { key: 1, ascending: false },\n  { key: 2, ascending: true }\n]);\nawait context.sync();"
        }
      ]
    },
    {
      "id": "filter",
      "name": "Filter Data",
      "description": "Apply auto-filter to data range",
      "triggers": ["filter", "saring", "auto filter"],
      "officeApis": ["getRange", "autoFilter", "apply"],
      "workflow": [
        "1. Identify range to filter",
        "2. Apply autoFilter with criteria",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Filter kolom B lebih dari 100",
          "code": "range.autoFilter.apply(range, [{ field: 2, criteria1: \">100\" }]);\nawait context.sync();"
        }
      ]
    },
    {
      "id": "chart",
      "name": "Create Chart",
      "description": "Create charts from data ranges",
      "triggers": ["chart", "grafik", "bar chart", "pie chart", "line chart", "visualisasi"],
      "officeApis": ["getRange", "charts", "add"],
      "workflow": [
        "1. Identify data range for chart",
        "2. Select chart type",
        "3. Create chart",
        "4. Configure title and styling",
        "5. Verify with context.sync()"
      ],
      "chartTypes": [
        "ColumnClustered", "ColumnStacked", "Column3D",
        "BarClustered", "BarStacked",
        "Line", "LineStacked",
        "Pie", "Pie3D", "Doughnut",
        "XYScatter", "Bubble",
        "Area", "AreaStacked"
      ],
      "examples": [
        {
          "request": "Buat bar chart dari data",
          "code": "let chart = sheet.charts.add(\"ColumnClustered\", range, \"Columns\");\nchart.title.text = \"Grafik Data\";\nchart.legend.position = \"bottom\";\nawait context.sync();"
        }
      ]
    },
    {
      "id": "pivot-table",
      "name": "Create PivotTable",
      "description": "Create PivotTables for data analysis",
      "triggers": ["pivot", "pivot table", "tabel pivot", "summary", "ringkasan"],
      "officeApis": ["pivotTables", "add", "addField"],
      "workflow": [
        "1. Ensure data is in table or range",
        "2. Create PivotTable",
        "3. Add row/column/value fields",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Buat pivot table",
          "code": "let pivot = sheet.pivotTables.add(\"Pivot1\", range, \"A1\");\npivot.addField(\"Row\", \"Category\");\npivot.addField(\"Values\", \"Amount\", \"Sum\");\nawait context.sync();"
        }
      ]
    },
    {
      "id": "conditional-format",
      "name": "Conditional Formatting",
      "description": "Apply conditional formatting rules",
      "triggers": ["conditional", "highlight", "warnai", "color scale", "data bar", "icon set"],
      "officeApis": ["getRange", "conditionalFormats", "add"],
      "workflow": [
        "1. Identify range to format",
        "2. Create conditional format rule",
        "3. Set condition and format",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Highlight sel yang lebih dari 80 dengan warna hijau",
          "code": "let rule = range.conditionalFormats.add(OfficeExtension.ConditionalFormatType.cellValue);\nrule.rule.operator = \"GreaterThan\";\nrule.rule.formula1 = \"80\";\nrule.format.fill.color = \"#00FF00\";\nawait context.sync();"
        }
      ]
    },
    {
      "id": "named-range",
      "name": "Named Range",
      "description": "Create and manage named ranges",
      "triggers": ["named range", "range name", "definisikan range", "nama range"],
      "officeApis": ["names", "add"],
      "workflow": [
        "1. Identify range to name",
        "2. Create named range",
        "3. Use name in formulas",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Buat named range 'DataNilai' untuk A1:D100",
          "code": "context.workbook.names.add(\"DataNilai\", sheet.getRange(\"A1:D100\"));\nawait context.sync();"
        }
      ]
    },
    {
      "id": "sheet-manager",
      "name": "Sheet Management",
      "description": "Create, rename, delete, and manage worksheets",
      "triggers": ["sheet", "worksheet", "buat sheet", "hapus sheet", "rename sheet", "salin sheet"],
      "officeApis": ["worksheets", "add", "delete", "name"],
      "workflow": [
        "1. Identify action (create/rename/delete/copy)",
        "2. Execute sheet operation",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Buat sheet baru bernama 'Laporan'",
          "code": "let newSheet = context.workbook.worksheets.add();\nnewSheet.name = \"Laporan\";\nawait context.sync();"
        },
        {
          "request": "Hapus Sheet3",
          "code": "context.workbook.worksheets.getItem(\"Sheet3\").delete();\nawait context.sync();"
        }
      ]
    },
    {
      "id": "protect",
      "name": "Sheet Protection",
      "description": "Protect and unprotect worksheets",
      "triggers": ["protect", "unprotect", "lock", "unlock", "proteksi"],
      "officeApis": ["protect", "unprotect"],
      "workflow": [
        "1. Identify protection action",
        "2. Apply protect/unprotect with password",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Proteksi sheet dengan password 123456",
          "code": "sheet.protect(\"123456\", { allowFiltering: true, allowSorting: true });\nawait context.sync();"
        }
      ]
    },
    {
      "id": "chart-format",
      "name": "Chart Formatting",
      "description": "Format and style charts",
      "triggers": ["chart format", "format chart", "style chart", "chart title"],
      "officeApis": ["chart", "title", "legend", "plotArea"],
      "workflow": [
        "1. Create or select chart",
        "2. Configure title, legend, colors",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Atur judul chart",
          "code": "chart.title.text = \"Grafik Penjualan\";\nchart.title.format.font.size = 14;\nchart.title.format.font.bold = true;\nawait context.sync();"
        }
      ]
    },
    {
      "id": "data-validation",
      "name": "Data Validation",
      "description": "Add data validation rules to cells",
      "triggers": ["validation", "validasi", "dropdown", "list data", "data rule"],
      "officeApis": ["getRange", "dataValidation", "add"],
      "workflow": [
        "1. Identify range to validate",
        "2. Create validation rule",
        "3. Set criteria and error message",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Buat dropdown di A1:A10 dengan pilihan Ya/Tidak",
          "code": "let validation = range.dataValidation.add();\nvalidation.rule.list = { inCellList: true, source: [\"Ya\", \"Tidak\"] };\nawait context.sync();"
        }
      ]
    },
    {
      "id": "merge-cells",
      "name": "Merge Cells",
      "description": "Merge and unmerge cell ranges",
      "triggers": ["merge", "gabung", "unmerge", "pisah"],
      "officeApis": ["getRange", "merge", "unmerge"],
      "workflow": [
        "1. Identify range to merge/unmerge",
        "2. Apply merge or unmerge",
        "3. Set alignment if needed",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Gabung sel A1:C1",
          "code": "sheet.getRange(\"A1:C1\").merge();\nsheet.getRange(\"A1:C1\").format.horizontalAlignment = \"center\";\nawait context.sync();"
        }
      ]
    },
    {
      "id": "copy-paste",
      "name": "Copy and Paste",
      "description": "Copy ranges and paste to new locations",
      "triggers": ["copy", "paste", "salin", "tempel", "duplicate"],
      "officeApis": ["getRange", "copy", "pasteSpecial"],
      "workflow": [
        "1. Identify source range",
        "2. Copy to clipboard",
        "3. Paste to destination",
        "4. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Salin data A1:D10 ke sheet lain mulai dari A1",
          "code": "sourceRange.copy();\ndestSheet.getRange(\"A1\").pasteSpecial(\"All\");\nawait context.sync();"
        }
      ]
    },
    {
      "id": "delete-rows-cols",
      "name": "Delete Rows/Columns",
      "description": "Delete rows or columns",
      "triggers": ["delete", "hapus", "remove row", "remove column"],
      "officeApis": ["getRange", "delete"],
      "workflow": [
        "1. Identify rows/columns to delete",
        "2. Delete with shift direction",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Hapus baris 5",
          "code": "sheet.getRange(\"5:5\").delete(OfficeExtension.DeleteShiftDirection.up);\nawait context.sync();"
        }
      ]
    },
    {
      "id": "insert-rows-cols",
      "name": "Insert Rows/Columns",
      "description": "Insert new rows or columns",
      "triggers": ["insert", "sisipkan", "add row", "add column"],
      "officeApis": ["getRange", "insert"],
      "workflow": [
        "1. Identify insertion point",
        "2. Insert with shift direction",
        "3. Verify with context.sync()"
      ],
      "examples": [
        {
          "request": "Sisipkan baris kosong di atas baris 5",
          "code": "sheet.getRange(\"5:5\").insert(OfficeExtension.InsertShiftDirection.down);\nawait context.sync();"
        }
      ]
    }
  ]
}
